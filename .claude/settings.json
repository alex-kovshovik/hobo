{
  "extraKnownMarketplaces": {
    "shovik-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "alex-kovshovik/shovik-claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "shovik-common@shovik-claude-plugins": true,
    "shovik-rails@shovik-claude-plugins": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env*)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(less .env*)",
      "Bash(less */.env*)",
      "Bash(head .env*)",
      "Bash(head */.env*)",
      "Bash(tail .env*)",
      "Bash(tail */.env*)",
      "Bash(cat * .env*)",
      "Bash(head * .env*)",
      "Bash(tail * .env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)"
    ]
  }
}
